+def test_resolve_strategy_id_fallback_priority():
+    """
+    验证 resolve_strategy_id() 的兜底优先级：合法值 → 上次用过的策略 → 第一条策略。
+    """
+    from prompts.templates import resolve_strategy_id, CATEGORY_STRATEGY_MAP
+
+    first_id = CATEGORY_STRATEGY_MAP['depression']['strategies'][0]['id']
+    third_id = CATEGORY_STRATEGY_MAP['depression']['strategies'][2]['id']
+
+    # 1. 合法值直接原样返回，不受 last_used_id 影响
+    assert resolve_strategy_id('depression', third_id, last_used_id=first_id) == third_id
+
+    # 2. strategy_id 非法但 last_used_id 合法 → 兜底为 last_used_id（停在原地，不退回起点）
+    assert resolve_strategy_id('depression', 'bogus_id', last_used_id=third_id) == third_id
+
+    # 3. strategy_id 和 last_used_id 都非法/缺失 → 退回该类别第一条（最后一层兜底）
+    assert resolve_strategy_id('depression', '', last_used_id='') == first_id
+    assert resolve_strategy_id('depression', 'bogus_id', last_used_id='also_bogus') == first_id
+
+    # 4. 不传 last_used_id（默认值）时行为与旧版一致：非法值直接退回第一条
+    assert resolve_strategy_id('depression', 'bogus_id') == first_id
+
+
+@pytest.mark.asyncio
+async def test_strategy_fallback_stays_at_last_used(llm_service):
+    """
+    集成验证：路由返回非法 strategy_id 时，stream_reply() 应该把这一轮兜底为该
+    会话在该类别里"上一轮实际用过的策略"，而不是永远退回该类别第一条策略。
+    """
+    session_id = 'test_strategy_fallback'
+    category = 'depression'
+    third_id = 'body_release'  # depression 策略库里的第 3 条，见 CATEGORY_STRATEGY_MAP
+
+    # 预先模拟这个会话在 depression 类别下已经推进到第 3 条策略
+    llm_service.strategy_history[session_id] = {category: [
+        'identify_negative_thoughts', 'cognitive_reframe', third_id,
+    ]}
+    llm_service.last_category[session_id] = category
+
+    empty_stream = AsyncMock()
+    empty_stream.__aiter__.return_value = []
+
+    # 路由这一轮返回了一个不在策略库里的非法 strategy_id（模拟路由模型抽风/解析异常兜底前的原始值）
+    with patch.object(llm_service, '_route_category', new_callable=AsyncMock) as mock_route:
+        mock_route.return_value = (category, '路由异常模拟', 'not_a_real_strategy_id')
+        with patch.object(llm_service.client.chat.completions, 'create', new_callable=AsyncMock) as mock_create:
+            mock_create.return_value = empty_stream
+
+            gen = llm_service.stream_reply("测试消息", {"label": "neutral"}, session_id)
+            chunks = [c async for c in gen]
+
+    done = next(c for c in chunks if c.get('type') == 'done')
+    # 应该兜底为"上一轮用过的策略"（第 3 条），不是该类别第一条
+    assert done['strategy_id'] == third_id
+    assert done['strategy_id'] != 'identify_negative_thoughts'
